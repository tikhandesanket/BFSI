# Optional — if unset, the backend uses a deterministic extractive answer instead of an LLM.
OPENAI_API_KEY=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
OPENAI_MODEL=gpt-4o-mini
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Semantic cache — a new question within this cosine similarity of a previous one
# replays the cached answer (no LLM call). Tuned for all-MiniLM-L6-v2.
CACHE_SIMILARITY_THRESHOLD=0.83
CACHE_MAX_ENTRIES=500

# Analytics cost model — USD per 1K tokens, priced against real API token usage.
LLM_COST_PER_1K_INPUT=0.0011
LLM_COST_PER_1K_OUTPUT=0.0044

# Human-agent deflection ("effort saved"): assumed handling time + loaded agent
# rate per question the assistant resolves without a human.
AGENT_MINUTES_PER_QUERY=5
AGENT_HOURLY_RATE_USD=20

# Set to 1 to seed synthetic Analytics history for a demo (default: real data only).
SEED_DEMO_METRICS=0
